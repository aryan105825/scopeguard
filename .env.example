# =============================================================================
# ScopeGuard Environment Configuration Template
# Copy to .env and fill in real values. NEVER commit the actual .env file.
# Every variable below MUST be referenced by name (os.environ / os.getenv)
# from its corresponding module. No value here may ever be hardcoded as a
# literal string anywhere else in the codebase.
# =============================================================================

# --- AWS / Bedrock / AgentCore -----------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=your-aws-session-token-if-using-temporary-credentials
AWS_REGION=us-east-1
BEDROCK_AGENTCORE_RUNTIME_ROLE_ARN=arn:aws:iam::123456789012:role/your-agentcore-runtime-role

# Model identifier — read from config/env only. Never hardcode a model id
# in any agent/*.py file. Used by scopeguard_main.py and auditor.py.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6-v1:0

# --- Slack (slack_bolt Events API app) --------------------------------------
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_TOKEN=xapp-your-slack-app-token-if-using-socket-mode

# --- Notion (SOW retrieval via mcp_sow_retriever.py) ------------------------
NOTION_API_KEY=secret_your-notion-integration-token

# --- Google Drive (SOW retrieval via mcp_sow_retriever.py) ------------------
# Prefer pointing to a service-account JSON file rather than inlining creds.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json
GOOGLE_DRIVE_SOW_FOLDER_ID=your-drive-folder-id-containing-sows

# --- Freelancer configuration ------------------------------------------------
# Used by the weekly digest to estimate hours/dollars of scope creep protected.
FREELANCER_HOURLY_RATE_USD=125

# =============================================================================
# RULE: Do not duplicate these values as string literals in any .py file.
# Always load via os.environ["VAR_NAME"] or os.getenv("VAR_NAME") from the
# module that owns that concern (agent/scopeguard_main.py for BEDROCK_MODEL_ID,
# slack_app/app.py for SLACK_*, server/mcp_sow_retriever.py for NOTION_API_KEY
# and GOOGLE_*, agent/memory.py for AWS_*/BEDROCK_AGENTCORE_*, and the digest
# module for FREELANCER_HOURLY_RATE_USD).
# =============================================================================